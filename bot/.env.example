# =========================
# BOT
# =========================
# BotFather dan olingan token
BOT_TOKEN=1234567890:REPLACE_WITH_REAL_BOT_TOKEN

# Asosiy admin Telegram user ID
ADMIN_ID=123456789

# polling yoki webhook
MODE=polling

# Render/webhook uchun portlar
PORT=10000
HEALTH_PORT=10001

# Mini App URL
WEBAPP_URL=https://your-webapp.vercel.app

# Bot username, masalan: @pazanda_ai_bot
BOT_USERNAME=pazanda_ai_bot

# =========================
# WEBHOOK OPTIONAL
# =========================
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

# =========================
# SUPABASE
# =========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# =========================
# CLOUDFLARE R2
# =========================
R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=pazanda-media
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
R2_UPLOAD_PREFIX=uploads

# =========================
# SCHEDULER
# =========================
TIMEZONE=Asia/Tashkent

# Kunlik retsept eslatmasi
DAILY_RECIPE_HOUR=09
DAILY_RECIPE_MINUTE=00

# Kunlik backup
DAILY_BACKUP_HOUR=02
DAILY_BACKUP_MINUTE=30

# =========================
# MIDDLEWARE
# =========================
ENABLE_THROTTLING=true
THROTTLE_RATE=0.5

# =========================
# PREMIUM PAYMENT
# =========================
PREMIUM_PRICE_UZS=25000
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
