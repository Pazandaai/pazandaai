# =====================================
# FRONTEND PUBLIC ENV — VITE_ PREFIX
# =====================================
VITE_APP_NAME=Pazanda AI
# Bo'sh qoldiring — production'da nisbiy /api ishlatiladi. "/api" deb YOZMANG!
VITE_API_BASE_URL=
VITE_DEFAULT_SCRIPT=latn

# Supabase public anon key.
# Bu kalit faqat RLS bilan himoyalangan public read uchun ishlatiladi.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# R2 public URL, rasmlarni ko'rsatish uchun
VITE_R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev


# =====================================
# SERVER-ONLY ENV — VITE_ PREFIX YO'Q
# =====================================
# Vercel serverless functions uchun.
# Frontend bundle ga chiqmaydi.

BOT_TOKEN=1234567890:REPLACE_WITH_REAL_BOT_TOKEN
ADMIN_ID=123456789

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=pazanda-media
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

UPLOAD_MAX_SIZE_MB=10
